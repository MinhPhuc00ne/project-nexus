FROM node:24-alpine AS dependencies
WORKDIR /app
RUN apk add --no-cache libc6-compat
COPY package*.json ./
COPY packages/config/package.json ./packages/config/
COPY packages/contracts/package.json ./packages/contracts/
COPY backend/package.json ./backend/
COPY frontend/package.json ./frontend/
COPY docs/package.json ./docs/
# `--legacy-peer-deps` is gone: the tree resolves on its own, and the flag was
# hiding whether it still did.
RUN npm ci

FROM node:24-alpine AS builder
WORKDIR /app
ARG VITE_API_URL
ENV VITE_API_URL=${VITE_API_URL:-http://localhost:3000/api/v1}
# The whole installed tree, not just the root `node_modules`: a workspace whose
# dependency range the root cannot satisfy gets its own nested copy, and
# contracts pins a TypeScript the root does not resolve to.
COPY --from=dependencies /app/ ./
COPY . .
RUN npm run build --workspace=@nexus/contracts
RUN npm run build --workspace=nexus-frontend

FROM nginx:1.27-alpine AS runner
WORKDIR /usr/share/nginx/html
RUN rm -rf ./*
COPY --from=builder /app/frontend/dist .

RUN printf 'server {\n\
    listen 80;\n\
    server_name localhost;\n\
    location / {\n\
        root /usr/share/nginx/html;\n\
        index index.html index.htm;\n\
        try_files $uri $uri/ /index.html;\n\
    }\n\
    error_page 500 502 503 504 /50x.html;\n\
    location = /50x.html {\n\
        root /usr/share/nginx/html;\n\
    }\n\
}\n' > /etc/nginx/conf.d/default.conf

EXPOSE 80

HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
  CMD wget --spider -q http://127.0.0.1/ || exit 1

CMD ["nginx", "-g", "daemon off;"]
