FROM node:24-alpine AS base
WORKDIR /app
RUN apk add --no-cache libc6-compat openssl

# Everything needed to build: the Nest CLI, TypeScript, the Prisma CLI.
FROM base AS dependencies
WORKDIR /app
COPY package*.json ./
COPY packages/config/package.json ./packages/config/
COPY packages/contracts/package.json ./packages/contracts/
COPY backend/package.json ./backend/
COPY frontend/package.json ./frontend/
COPY docs/package.json ./docs/
# `--legacy-peer-deps` is gone: the dependency tree resolves on its own, and the
# flag was hiding whether it still did.
RUN npm ci

FROM base AS builder
WORKDIR /app
ENV DATABASE_URL=postgresql://postgres:postgres@localhost:5432/nexus_build
# The whole installed tree, not just the root `node_modules`. A workspace whose
# dependency range the root cannot satisfy gets its own nested copy — contracts
# pins TypeScript 5 while the repository root resolves 6 — and copying only the
# root left that workspace compiling with the wrong compiler, which failed on a
# compiler option the older one accepts.
COPY --from=dependencies /app/ ./
COPY . .
RUN npm run db:generate
RUN npm run build --workspace=@nexus/contracts
RUN npm run build --workspace=nexus-backend

# What the server needs to run, and nothing else.
#
# The runner used to copy the builder's whole `node_modules`: the Nest CLI,
# TypeScript, vitest, eslint and their trees, in the image that faces the
# internet. Installing production dependencies separately keeps the build tools
# out of it.
FROM base AS production-dependencies
WORKDIR /app
COPY package*.json ./
COPY packages/config/package.json ./packages/config/
COPY packages/contracts/package.json ./packages/contracts/
COPY backend/package.json ./backend/
COPY frontend/package.json ./frontend/
COPY docs/package.json ./docs/
RUN npm ci --omit=dev --ignore-scripts --workspace=nexus-backend --workspace=@nexus/contracts && mkdir -p /app/backend/node_modules

# Applies migrations and creates the system rows.
#
# This keeps the full dependency tree because it runs the Prisma CLI and
# ts-node, which the server itself does not need. It carries the schema, the
# migrations and the system seed — but not `prisma/seeds/demo`, which shares one
# printed password across every account it creates and has no business in an
# image that might be deployed.
FROM base AS migrator
WORKDIR /app
ENV NODE_ENV=production
COPY --from=dependencies /app/node_modules ./node_modules
# Preserve nested backend workspace dependencies (e.g. dotenv@18, typescript@5.9).
COPY --from=dependencies /app/backend/node_modules ./backend/node_modules
# The built packages, with the nested installs each workspace needs.
COPY --from=builder /app/packages ./packages
COPY --from=builder /app/node_modules/.prisma ./node_modules/.prisma
COPY backend/package.json backend/tsconfig.json backend/prisma.config.ts ./backend/
COPY backend/prisma/schema.prisma ./backend/prisma/
COPY backend/prisma/migrations ./backend/prisma/migrations
COPY backend/prisma/seeds/client.ts backend/prisma/seeds/system.ts ./backend/prisma/seeds/
COPY package.json ./package.json
WORKDIR /app/backend
CMD ["sh", "-c", "npx prisma migrate deploy --schema=prisma/schema.prisma && npx ts-node --project tsconfig.json prisma/seeds/system.ts"]

FROM base AS runner
WORKDIR /app
ENV NODE_ENV=production

RUN addgroup --system --gid 1001 nodejs && \
    adduser --system --uid 1001 nestjs

COPY --from=production-dependencies --chown=nestjs:nodejs /app/node_modules ./node_modules
# Preserve nested backend production dependencies (e.g. file-type@16.5.4 for CJS fromBuffer, dotenv@18).
COPY --from=production-dependencies --chown=nestjs:nodejs /app/backend/node_modules ./backend/node_modules
# The Prisma client is generated during the build, so it is taken from there
# rather than regenerated with a CLI this image does not carry.
COPY --from=builder --chown=nestjs:nodejs /app/node_modules/.prisma ./node_modules/.prisma
COPY --from=builder --chown=nestjs:nodejs /app/packages ./packages
COPY --from=builder --chown=nestjs:nodejs /app/backend/dist ./backend/dist
# Ship schema, migrations, Prisma config, and compiled system seed (`dist/prisma/seeds/system.js`)
# for portable `preDeployCommand` execution. Demo seeds (`prisma/seeds/demo`) stay excluded.
COPY --from=builder --chown=nestjs:nodejs /app/backend/prisma/schema.prisma ./backend/prisma/schema.prisma
COPY --from=builder --chown=nestjs:nodejs /app/backend/prisma/migrations ./backend/prisma/migrations
COPY --from=builder --chown=nestjs:nodejs /app/backend/prisma.config.ts ./backend/prisma.config.ts
COPY --from=builder --chown=nestjs:nodejs /app/backend/package.json ./backend/package.json
COPY --from=builder --chown=nestjs:nodejs /app/package.json ./package.json

USER nestjs
EXPOSE 3000
WORKDIR /app/backend

# `/api/v1/health/ready` verifies PostgreSQL and Redis readiness before the container
# accepts traffic, avoiding false-positive checks against documentation routes.
HEALTHCHECK --interval=30s --timeout=5s --start-period=20s --retries=3 \
  CMD wget --spider -q "http://127.0.0.1:${PORT:-3000}/api/v1/health/ready" || exit 1

CMD ["node", "dist/main.js"]
