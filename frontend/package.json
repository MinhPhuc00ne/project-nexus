{
  "name": "nexus-frontend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Project Nexus - Buyer & Seller Frontend Portal",
  "scripts": {
    "dev": "vite",
    "prebuild": "npm run build --workspace=@nexus/contracts",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b --noEmit && npm run typecheck:test",
    "typecheck:test": "tsc --noEmit -p tsconfig.test.json",
    "lint": "eslint .",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@hookform/resolvers": "^7.0.9",
    "@nexus/contracts": "*",
    "@tanstack/react-query": "^5.108.4",
    "axios": "^1.21.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "i18next": "^27.2.10",
    "i18next-browser-languagedetector": "^8.3.1",
    "lucide-react": "^1.82.0",
    "qrcode": "^1.5.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-hook-form": "^7.92.0",
    "react-i18next": "^18.0.3",
    "react-router-dom": "^7.18.7",
    "socket.io-client": "^4.8.4",
    "tailwind-merge": "^3.7.1"
  },
  "devDependencies": {
    "@nexus/config": "*",
    "@tailwindcss/vite": "^4.3.5",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^8.0.0",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.13",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.3",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "@vitest/coverage-v8": "^5.1.2",
    "jsdom": "^31.0.1",
    "tailwindcss": "^4.3.5",
    "typescript": "^5.9.3",
    "vite": "^8.4.0",
    "vitest": "^5.1.2"
  }
}
