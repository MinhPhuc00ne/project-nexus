{
  "name": "nexus-monorepo",
  "version": "1.0.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "packageManager": "npm@11.19.0",
  "description": "Project Nexus - Multi-Shop E-Commerce and Real-Time 3D Live Auctions",
  "homepage": "https://minhphuc00ne.github.io/project-nexus/",
  "repository": {
    "type": "git",
    "url": "https://github.com/MinhPhuc00ne/project-nexus.git"
  },
  "bugs": {
    "url": "https://github.com/MinhPhuc00ne/project-nexus/issues"
  },
  "workspaces": [
    "packages/*",
    "backend",
    "frontend",
    "docs"
  ],
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "test": "turbo test",
    "test:e2e:smoke": "playwright test",
    "docs:openapi": "npm run docs:openapi --workspace=backend",
    "docs:check": "node docs/scripts/check-docs.mjs",
    "docs:dev": "npm run start --workspace=docs",
    "docs:build": "npm run build --workspace=docs",
    "i18n:check": "node frontend/scripts/check-i18n-parity.mjs",
    "test:coverage": "npm run test:coverage --workspace=backend --if-present && npm run test:coverage --workspace=frontend --if-present",
    "build:types": "npm run build --workspace=@nexus/types --if-present",
    "build:contracts": "npm run build --workspace=@nexus/contracts",
    "dev:backend": "npm run start:dev --workspace=backend",
    "dev:frontend": "npm run dev --workspace=frontend",
    "dev:web": "npm run dev:frontend",
    "build:backend": "npm run build --workspace=backend",
    "build:frontend": "npm run build --workspace=frontend",
    "build:web": "npm run build:frontend",
    "build:all": "turbo build",
    "prisma:generate": "npm run prisma:generate --workspace=backend --if-present",
    "prisma:migrate": "npm run prisma:migrate --workspace=backend --if-present",
    "prisma:seed": "npm run prisma:seed --workspace=backend --if-present",
    "prisma:studio": "npm run prisma:studio --workspace=backend --if-present",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "prepare": "husky",
    "docker:up": "docker compose up -d",
    "docker:infra": "docker compose up -d",
    "docker:full": "docker compose --profile full up --build -d",
    "docker:down": "docker compose --profile full down",
    "docker:clean": "docker compose --profile full down -v",
    "docker:logs": "docker compose logs -f",
    "db:verify": "npm run db:verify --workspace=backend",
    "db:bootstrap": "npm run db:bootstrap --workspace=backend",
    "admin:create": "npm run admin:create --workspace=backend",
    "seed:demo": "npm run seed:demo --workspace=backend",
    "seed:demo:reset": "npm run seed:demo:reset --workspace=backend",
    "check:cycles": "npm run check:cycles --workspace=backend"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@playwright/test": "^1.65.1",
    "eslint": "^10.12.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.8",
    "eslint-plugin-sonarjs": "^4.2.2",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.10",
    "turbo": "^2.11.10",
    "typescript-eslint": "^8.71.1"
  }
}
