{
  "name": "nexus-monorepo",
  "version": "1.0.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "packageManager": "npm@11.19.0",
  "description": "Project Nexus - Multi-Shop E-Commerce and Real-Time 3D Live Auctions",
  "homepage": "https://minhphuc00ne.github.io/project-nexus/",
  "repository": {
    "type": "git",
    "url": "https://github.com/MinhPhuc00ne/project-nexus.git"
  },
  "bugs": {
    "url": "https://github.com/MinhPhuc00ne/project-nexus/issues"
  },
  "workspaces": [
    "packages/*",
    "backend",
    "frontend",
    "docs"
  ],
  "scripts": {
    "dev": "turbo dev",
    "dev:backend": "npm run start:dev --workspace=nexus-backend",
    "dev:frontend": "npm run dev --workspace=nexus-frontend",
    "build": "turbo build",
    "build:types": "npm run build --workspace=@nexus/types --if-present",
    "build:contracts": "npm run build --workspace=@nexus/contracts",
    "build:backend": "npm run build --workspace=nexus-backend",
    "build:frontend": "npm run build --workspace=nexus-frontend",
    "typecheck": "turbo typecheck",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check:cycles": "npm run check:cycles --workspace=nexus-backend",
    "i18n:check": "node frontend/scripts/check-i18n-parity.mjs",
    "test": "turbo test",
    "test:backend": "npm test --workspace=nexus-backend",
    "test:frontend": "npm test --workspace=nexus-frontend",
    "test:coverage": "npm run test:coverage --workspace=nexus-backend --if-present && npm run test:coverage --workspace=nexus-frontend --if-present",
    "test:e2e:smoke": "playwright test",
    "db:generate": "npm run prisma:generate --workspace=nexus-backend",
    "db:migrate": "npm run prisma:migrate --workspace=nexus-backend",
    "db:deploy": "npm run prisma:deploy --workspace=nexus-backend",
    "db:bootstrap": "npm run db:bootstrap --workspace=nexus-backend",
    "db:verify": "npm run db:verify --workspace=nexus-backend",
    "db:studio": "npm run prisma:studio --workspace=nexus-backend",
    "admin:create": "npm run admin:create --workspace=nexus-backend",
    "seed:demo": "npm run seed:demo --workspace=nexus-backend",
    "seed:demo:reset": "npm run seed:demo:reset --workspace=nexus-backend",
    "docker:infra": "docker compose up -d",
    "docker:full": "docker compose --profile full up --build -d",
    "docker:demo": "docker compose -f infra/docker-compose.yml -f infra/docker-compose.demo.yml --profile full --profile demo up --build -d",
    "docker:down": "docker compose --profile full down",
    "docker:clean": "docker compose --profile full down -v",
    "docker:logs": "docker compose logs -f",
    "docs:openapi": "npm run docs:openapi --workspace=nexus-backend",
    "docs:check": "node docs/scripts/check-docs.mjs",
    "docs:dev": "npm run start --workspace=nexus-docs",
    "docs:build": "npm run build --workspace=nexus-docs",
    "verify": "npm run format:check && npm run lint && npm run i18n:check && npm run docs:check && npm run check:cycles && npm run build && npm run typecheck && npm test",
    "prepare": "husky"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@playwright/test": "^1.65.1",
    "eslint": "^10.12.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.8",
    "eslint-plugin-sonarjs": "^4.2.2",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.10",
    "turbo": "^2.11.10",
    "typescript-eslint": "^8.71.1"
  }
}
