{
  "name": "nexus-monorepo",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Project Nexus - Monolithic Architecture",
  "workspaces": [
    "packages/*",
    "backend",
    "frontend/*"
  ],
  "scripts": {
    "build:types": "npm run build --workspace=@nexus/types --if-present",
    "dev:backend": "npm run start:dev --workspace=backend",
    "dev:web": "npm run dev --workspace=frontend/web",
    "dev:admin": "npm run dev --workspace=frontend/admin",
    "build:backend": "npm run build --workspace=backend",
    "build:web": "npm run build --workspace=frontend/web",
    "build:admin": "npm run build --workspace=frontend/admin",
    "build:all": "npm run build:types && npm run build:backend && npm run build:web && npm run build:admin",
    "prisma:generate": "npm run prisma:generate --workspace=backend --if-present",
    "prisma:migrate": "npm run prisma:migrate --workspace=backend --if-present",
    "prisma:seed": "npm run prisma:seed --workspace=backend --if-present",
    "prisma:studio": "npm run prisma:studio --workspace=backend --if-present",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "prepare": "husky",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "docker:clean": "docker compose down -v",
    "docker:logs": "docker compose logs -f"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "eslint": "^10.12.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.9",
    "prisma": "^8.0.0-rc.22",
    "typescript-eslint": "^8.71.1"
  },
  "lint-staged": {
    "*.{js,mjs,cjs,ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,yml,yaml,css}": [
      "prettier --write"
    ]
  },
  "dependencies": {
    "@prisma/client": "^7.10.0"
  }
}
