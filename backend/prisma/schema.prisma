generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  SUPPORT_STAFF
  SELLER
  BUYER
  GUEST
}

enum OrderStatus {
  PENDING_PAYMENT
  PAID
  PREPARING
  SHIPPING
  DELIVERED
  CONFIRMED
  CANCELLED
  REFUNDED
}

enum AuctionStatus {
  DRAFT
  SCHEDULED
  ACTIVE
  EXTENDED
  ENDED
  SETTLED
  CANCELLED
  FAILED
}

enum AuctionItemStatus {
  PENDING_REVIEW
  APPROVED
  REJECTED
}

enum EscrowStatus {
  HELD
  DISBURSED
  REFUNDED
  DISPUTED
}

enum DisputeStatus {
  OPEN
  UNDER_REVIEW
  RESOLVED_SELLER_FAVOR
  RESOLVED_BUYER_FAVOR
  CANCELLED
}

enum PaymentProvider {
  PAYOS
  WALLET
  COD
}

enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
  CANCELLED
}

enum CarrierName {
  GHN
}

enum ShipmentStatus {
  CREATED
  PICKED_UP
  IN_TRANSIT
  DELIVERED
  FAILED
  RETURNED
}

enum ReputationTrustLevel {
  EXCELLENT
  GOOD
  STANDARD
  PROBATION
  SUSPENDED
}

enum PenaltyType {
  PAYMENT_TIMEOUT
  ORDER_CANCELLATION
  AUCTION_DEFAULT
  MISREPRESENTATION
  FRAUD
}

enum NotificationChannel {
  EMAIL
  PUSH
  IN_APP
}

enum NotificationType {
  ORDER
  AUCTION
  SYSTEM
  PAYMENT
  DISPUTE
}

enum WalletTransactionType {
  DEPOSIT
  WITHDRAW
  ESCROW_LOCK
  ESCROW_PAYOUT
  ESCROW_REFUND
  ORDER_PAYMENT
  PLATFORM_FEE
  AUCTION_BID_LOCK
  AUCTION_BID_REFUND
}

enum WalletTransactionStatus {
  PENDING
  SUCCESS
  FAILED
}

enum ProductStatus {
  DRAFT
  ACTIVE
  INACTIVE
}

enum ReservationStatus {
  PENDING
  COMMITTED
  RELEASED
}

enum BidStatus {
  ACCEPTED
  SUPERSEDED
  WINNING
  REJECTED
}

enum SellerRequestStatus {
  PENDING
  APPROVED
  REJECTED
}

enum ShopActionType {
  WARN
  SUSPEND
  RESTORE
}

enum ViolationStatus {
  PENDING
  INVESTIGATING
  CONFIRMED
  DISMISSED
}

enum WithdrawalStatus {
  PENDING
  APPROVED
  REJECTED
  COMPLETED
}

model User {
  id                String               @id @default(uuid())
  email             String               @unique
  passwordHash      String               @map("password_hash")
  fullName          String               @map("full_name")
  phoneNumber       String?              @map("phone_number")
  avatarUrl         String?              @map("avatar_url")
  shopAvatarUrl     String?              @map("shop_avatar_url")
  role              Role                 @default(BUYER)
  isSellerActive    Boolean              @default(false) @map("is_seller_active")
  isShopSuspended   Boolean              @default(false) @map("is_shop_suspended")
  suspensionReason  String?              @map("suspension_reason") @db.Text
  reputationScore   Int                  @default(50) @map("reputation_score")
  trustLevel        ReputationTrustLevel @default(PROBATION) @map("trust_level")
  isVerified        Boolean              @default(false) @map("is_verified")
  verificationCode  String?              @map("verification_code")
  codeExpiresAt     DateTime?            @map("code_expires_at")
  personalEmail     String?              @map("personal_email") @db.VarChar(255)
  platformEmail     String?              @unique @map("platform_email") @db.VarChar(255)
  bankName          String?              @map("bank_name") @db.VarChar(120)
  accountNumber     String?              @map("account_number") @db.VarChar(50)
  accountHolderName String?              @map("account_holder_name") @db.VarChar(150)
  createdAt         DateTime             @default(now()) @map("created_at")
  updatedAt         DateTime             @updatedAt @map("updated_at")

  wallet                     Wallet?
  addresses                  UserAddress[]
  refreshTokens              RefreshToken[]
  products                   Product[]
  ordersAsBuyer              Order[]                  @relation("BuyerOrders")
  ordersAsSeller             Order[]                  @relation("SellerOrders")
  auctions                   Auction[]                @relation("SellerAuctions")
  createdAuctions            Auction[]                @relation("AdminCreatedAuctions")
  submittedAuctionItems      AuctionItem[]            @relation("SellerAuctionItems")
  reviewedAuctionItems       AuctionItem[]            @relation("AdminReviewedAuctionItems")
  bids                       Bid[]
  cart                       Cart?
  reputationLogs             ReputationLog[]
  notifications              Notification[]
  notificationPreferences    NotificationPreference[]
  reviewsGiven               Review[]                 @relation("Reviewer")
  reviewsReceived            Review[]                 @relation("Reviewee")
  disputesOpened             Dispute[]                @relation("DisputeOpener")
  disputesResolved           Dispute[]                @relation("DisputeResolver")
  sellerUpgradeRequests      SellerUpgradeRequest[]   @relation("UserSellerRequests")
  reviewedSellerRequests     SellerUpgradeRequest[]   @relation("AdminReviewedSellerRequests")
  shopActionLogs             ShopActionLog[]          @relation("ShopActionLogs")
  administeredShopActionLogs ShopActionLog[]          @relation("AdminShopActionLogs")
  shopViolations             ShopViolation[]          @relation("ShopViolations")
  reportedShopViolations     ShopViolation[]          @relation("ReportedShopViolations")
  handledShopViolations      ShopViolation[]          @relation("HandledShopViolations")
  withdrawalRequests         WithdrawalRequest[]      @relation("UserWithdrawalRequests")
  reviewedWithdrawalRequests WithdrawalRequest[]      @relation("AdminReviewedWithdrawals")
  chatConversationsUser1     ChatConversation[]       @relation("ChatParticipant1")
  chatConversationsUser2     ChatConversation[]       @relation("ChatParticipant2")
  assignedStaffConversations ChatConversation[]       @relation("AssignedStaffConversations")
  chatMessagesSent           ChatMessage[]            @relation("ChatSender")
  shopAutoReplies            ChatAutoReply[]          @relation("ShopAutoReplies")
  cancelledAutoReplies       ChatAutoReply[]          @relation("AdminCancelledReplies")
  ghnAccounts                SellerGhnAccount[]
  productReviews             ProductReview[]
  customerReviewsGiven       CustomerReview[]         @relation("CustomerReviewer")
  customerReviewsReceived    CustomerReview[]         @relation("CustomerReviewee")
  eventBanners               EventBanner[]
  bannerDisableActions       BannerDisableHistory[]

  @@map("users")
}

model UserAddress {
  id               String   @id @default(uuid())
  userId           String   @map("user_id")
  recipientName    String   @map("recipient_name")
  phone            String
  street           String
  ward             String?
  district         String?
  city             String
  country          String   @default("VN")
  latitude         Decimal? @db.Decimal(10, 8)
  longitude        Decimal? @db.Decimal(11, 8)
  formattedAddress String?  @map("formatted_address")
  placeId          String?  @map("place_id")
  isDefault        Boolean  @default(false) @map("is_default")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_addresses")
}

model RefreshToken {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  tokenHash String   @map("token_hash")
  expiresAt DateTime @map("expires_at")
  isRevoked Boolean  @default(false) @map("is_revoked")
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("refresh_tokens")
}

model Wallet {
  id            String   @id @default(uuid())
  userId        String   @unique @map("user_id")
  balance       Decimal  @default(0) @db.Decimal(14, 2)
  lockedBalance Decimal  @default(0) @map("locked_balance") @db.Decimal(14, 2)
  currency      String   @default("VND")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  user         User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions WalletTransaction[]
  refunds      OrderRefund[]

  @@map("wallets")
}

model WalletTransaction {
  id          String                  @id @default(uuid())
  walletId    String                  @map("wallet_id")
  amount      Decimal                 @db.Decimal(14, 2)
  type        WalletTransactionType
  status      WalletTransactionStatus @default(SUCCESS)
  referenceId String?                 @map("reference_id")
  description String?
  createdAt   DateTime                @default(now()) @map("created_at")

  wallet Wallet @relation(fields: [walletId], references: [id], onDelete: Cascade)
  refund OrderRefund?

  @@map("wallet_transactions")
}

model ReputationLog {
  id           String       @id @default(uuid())
  userId       String       @map("user_id")
  deltaPoints  Int          @map("delta_points")
  balanceAfter Int          @map("balance_after")
  reason       String
  penaltyType  PenaltyType? @map("penalty_type")
  referenceId  String?      @map("reference_id")
  createdAt    DateTime     @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("reputation_logs")
}

model Category {
  id        String   @id @default(uuid())
  name      String
  slug      String   @unique
  parentId  String?  @map("parent_id")
  level     Int      @default(1)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  parent   Category?  @relation("CategoryHierarchy", fields: [parentId], references: [id], onDelete: Restrict)
  children Category[] @relation("CategoryHierarchy")
  products Product[]

  @@map("categories")
}

model Product {
  id                     String        @id @default(uuid())
  sellerId               String        @map("seller_id")
  categoryId             String        @map("category_id")
  title                  String
  description            String        @db.Text
  basePrice              Decimal       @map("base_price") @db.Decimal(14, 2)
  weightGrams            Int           @default(500) @map("weight_grams")
  lengthCm               Int           @default(10) @map("length_cm")
  widthCm                Int           @default(10) @map("width_cm")
  heightCm               Int           @default(10) @map("height_cm")
  threeModelKey          String?       @map("three_model_key")
  status                 ProductStatus @default(ACTIVE)
  hiddenByShopSuspension Boolean       @default(false) @map("hidden_by_shop_suspension")
  salePrice              Decimal?      @map("sale_price") @db.Decimal(14, 2)
  saleStartsAt           DateTime?     @map("sale_starts_at")
  saleEndsAt             DateTime?     @map("sale_ends_at")
  reviewCount            Int           @default(0) @map("review_count")
  ratingSum              Int           @default(0) @map("rating_sum")
  averageRating          Float         @default(0) @map("average_rating")
  createdAt              DateTime      @default(now()) @map("created_at")
  updatedAt              DateTime      @updatedAt @map("updated_at")

  seller         User            @relation(fields: [sellerId], references: [id], onDelete: Restrict)
  category       Category        @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  images         ProductImage[]
  inventories    Inventory[]
  cartItems      CartItem[]
  orderItems     OrderItem[]
  auctions       Auction[]
  options        ProductOption[]
  productReviews ProductReview[]
  reports        ShopViolation[]

  @@map("products")
}

model ProductImage {
  id          String   @id @default(uuid())
  productId   String   @map("product_id")
  imageUrl    String   @map("image_url")
  isThumbnail Boolean  @default(false) @map("is_thumbnail")
  sortOrder   Int      @default(0) @map("sort_order")
  createdAt   DateTime @default(now()) @map("created_at")

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@map("product_images")
}

model ProductOption {
  id        String   @id @default(uuid())
  productId String   @map("product_id")
  name      String
  values    String[]
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([productId, name])
  @@map("product_options")
}

model Warehouse {
  id        String   @id @default(uuid())
  code      String   @unique @default("WH_001")
  name      String
  address   String?
  latitude  Decimal? @db.Decimal(10, 8)
  longitude Decimal? @db.Decimal(11, 8)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  inventories Inventory[]

  @@map("warehouses")
}

/// Carrier registration metadata; the pickup address comes from the current shop profile.
model SellerGhnAccount {
  id                 String    @id @default(uuid())
  sellerId           String    @map("seller_id")
  environment        String
  profileFingerprint String?   @map("profile_fingerprint")
  districtId         Int       @map("district_id")
  wardCode           String    @map("ward_code")
  status             String    @default("PENDING")
  version            Int       @default(1)
  ghnShopId          Int?      @map("ghn_shop_id")
  ghnClientId        Int?      @map("ghn_client_id")
  carrierName        String?   @map("carrier_name")
  carrierPhone       String?   @map("carrier_phone")
  carrierAddress     String?   @map("carrier_address")
  verifiedBy         String?   @map("verified_by")
  verifiedAt         DateTime? @map("verified_at")
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")

  seller User @relation(fields: [sellerId], references: [id], onDelete: Restrict)

  @@unique([sellerId, environment])
  @@unique([environment, ghnShopId])
  @@index([environment, status])
  @@map("seller_ghn_accounts")
}

model Inventory {
  id           String   @id @default(uuid())
  warehouseId  String   @map("warehouse_id")
  productId    String   @map("product_id")
  totalQty     Int      @default(0) @map("total_qty")
  availableQty Int      @default(0) @map("available_qty")
  reservedQty  Int      @default(0) @map("reserved_qty")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  warehouse    Warehouse              @relation(fields: [warehouseId], references: [id], onDelete: Restrict)
  product      Product                @relation(fields: [productId], references: [id], onDelete: Restrict)
  reservations InventoryReservation[]
  ledgers      InventoryLedger[]

  @@unique([warehouseId, productId])
  @@map("inventories")
}

model InventoryReservation {
  id          String            @id @default(uuid())
  inventoryId String            @map("inventory_id")
  quantity    Int
  referenceId String            @map("reference_id")
  status      ReservationStatus @default(PENDING)
  expiresAt   DateTime          @map("expires_at")
  createdAt   DateTime          @default(now()) @map("created_at")
  updatedAt   DateTime          @updatedAt @map("updated_at")

  inventory Inventory @relation(fields: [inventoryId], references: [id], onDelete: Cascade)

  @@map("inventory_reservations")
}

model InventoryLedger {
  id           String   @id @default(uuid())
  inventoryId  String   @map("inventory_id")
  changeQty    Int      @map("change_qty")
  balanceAfter Int      @map("balance_after")
  reason       String
  referenceId  String?  @map("reference_id")
  createdAt    DateTime @default(now()) @map("created_at")

  inventory Inventory @relation(fields: [inventoryId], references: [id], onDelete: Cascade)

  @@map("inventory_ledgers")
}

model Cart {
  id        String   @id @default(uuid())
  userId    String   @unique @map("user_id")
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user  User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  items CartItem[]

  @@map("carts")
}

model CartItem {
  id           String   @id @default(uuid())
  cartId       String   @map("cart_id")
  productId    String   @map("product_id")
  optionKey    String   @default("") @map("option_key")
  selections   Json?
  quantity     Int      @default(1)
  priceAtAdded Decimal  @map("price_at_added") @db.Decimal(14, 2)
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  cart    Cart    @relation(fields: [cartId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([cartId, productId, optionKey])
  @@map("cart_items")
}

model Order {
  id                      String      @id @default(uuid())
  buyerId                 String      @map("buyer_id")
  sellerId                String      @map("seller_id")
  subtotal                Decimal     @db.Decimal(14, 2)
  shippingFee             Decimal     @default(0) @map("shipping_fee") @db.Decimal(14, 2)
  totalAmount             Decimal     @map("total_amount") @db.Decimal(14, 2)
  status                  OrderStatus @default(PENDING_PAYMENT)
  isAuction               Boolean     @default(false) @map("is_auction")
  cancellationActor       String?     @map("cancellation_actor")
  shippingAddressSnapshot Json        @map("shipping_address_snapshot")
  idempotencyKey          String?     @unique @map("idempotency_key")
  createdAt               DateTime    @default(now()) @map("created_at")
  updatedAt               DateTime    @updatedAt @map("updated_at")

  buyer          User            @relation("BuyerOrders", fields: [buyerId], references: [id], onDelete: Restrict)
  seller         User            @relation("SellerOrders", fields: [sellerId], references: [id], onDelete: Restrict)
  items          OrderItem[]
  payments       Payment[]
  escrowRecord   EscrowRecord?
  shipment       Shipment?
  dispute        Dispute?
  review         Review?
  productReviews ProductReview[]
  customerReview CustomerReview?
  afterSales     AfterSalesRequest?
  refunds        OrderRefund[]
  auctionAward   AuctionAward?

  @@map("orders")
}

model OrderItem {
  id         String   @id @default(uuid())
  orderId    String   @map("order_id")
  productId  String   @map("product_id")
  selections Json?
  quantity   Int      @default(1)
  unitPrice  Decimal  @map("unit_price") @db.Decimal(14, 2)
  totalPrice Decimal  @map("total_price") @db.Decimal(14, 2)
  createdAt  DateTime @default(now()) @map("created_at")

  order   Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@map("order_items")
}

model Payment {
  id              String          @id @default(uuid())
  orderId         String          @map("order_id")
  provider        PaymentProvider
  amount          Decimal         @db.Decimal(14, 2)
  status          PaymentStatus   @default(PENDING)
  transactionCode String?         @map("transaction_code")
  idempotencyKey  String?         @unique @map("idempotency_key")
  metadata        Json?
  createdAt       DateTime        @default(now()) @map("created_at")
  updatedAt       DateTime        @updatedAt @map("updated_at")

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
  refund OrderRefund?

  @@map("payments")
}

model AfterSalesRequest {
  id                 String   @id @default(uuid())
  orderId            String   @unique @map("order_id")
  kind               String
  status             String   @default("REQUESTED")
  requestedBy        String   @map("requested_by")
  reason             String   @db.Text
  evidenceUrls       Json?    @map("evidence_urls")
  refundToWallet     Boolean  @default(false) @map("refund_to_wallet")
  decisionReason     String?  @map("decision_reason") @db.Text
  reviewedBy         String?  @map("reviewed_by")
  returnWaybillCode  String?  @map("return_waybill_code")
  receivedAt         DateTime? @map("received_at")
  restockedAt        DateTime? @map("restocked_at")
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")
  order              Order    @relation(fields: [orderId], references: [id], onDelete: Restrict)

  @@index([status, createdAt])
  @@map("after_sales_requests")
}

model OrderRefund {
  id                String   @id @default(uuid())
  orderId           String   @map("order_id")
  paymentId         String   @unique @map("payment_id")
  amount            Decimal  @db.Decimal(14, 2)
  destination       String
  status            String   @default("PENDING")
  adminWalletId     String   @map("admin_wallet_id")
  transactionId     String   @unique @map("transaction_id")
  externalReference String?  @unique @map("external_reference")
  completedBy       String?  @map("completed_by")
  completedAt       DateTime? @map("completed_at")
  createdAt         DateTime @default(now()) @map("created_at")
  order             Order    @relation(fields: [orderId], references: [id], onDelete: Restrict)
  payment           Payment  @relation(fields: [paymentId], references: [id], onDelete: Restrict)
  adminWallet       Wallet   @relation(fields: [adminWalletId], references: [id], onDelete: Restrict)
  transaction       WalletTransaction @relation(fields: [transactionId], references: [id], onDelete: Restrict)

  @@index([status, createdAt])
  @@map("order_refunds")
}

model Auction {
  id                     String        @id @default(uuid())
  productId              String?       @map("product_id")
  sellerId               String?       @map("seller_id")
  title                  String
  description            String?       @db.Text
  imageUrl               String?       @map("image_url")
  startingPrice          Decimal       @default(0) @map("starting_price") @db.Decimal(14, 2)
  reservePrice           Decimal?      @map("reserve_price") @db.Decimal(14, 2)
  currentHighestBid      Decimal       @default(0) @map("current_highest_bid") @db.Decimal(14, 2)
  currentHighestBidderId String?       @map("current_highest_bidder_id")
  bidIncrement           Decimal       @default(100000.0) @map("bid_increment") @db.Decimal(14, 2)
  status                 AuctionStatus @default(SCHEDULED)
  startTime              DateTime      @map("start_time")
  endTime                DateTime      @map("end_time")
  originalEndTime        DateTime      @map("original_end_time")
  isExtended             Boolean       @default(false) @map("is_extended")
  totalBidsCount         Int           @default(0) @map("total_bids_count")

  minBuyerReputation     Int           @default(40) @map("min_buyer_reputation")
  minSellerReputation    Int           @default(50) @map("min_seller_reputation")
  createdByAdminId       String?       @map("created_by_admin_id")

  createdAt              DateTime      @default(now()) @map("created_at")
  updatedAt              DateTime      @updatedAt @map("updated_at")

  product        Product?      @relation(fields: [productId], references: [id], onDelete: SetNull)
  seller         User?         @relation("SellerAuctions", fields: [sellerId], references: [id], onDelete: SetNull)
  createdByAdmin User?         @relation("AdminCreatedAuctions", fields: [createdByAdminId], references: [id], onDelete: SetNull)
  bids           Bid[]
  items          AuctionItem[]
  awards         AuctionAward[]
  banners        EventBanner[]

  @@index([status, endTime])
  @@map("auctions")
}

model AuctionItem {
  id                         String            @id @default(uuid())
  auctionId                  String            @map("auction_id")
  sellerId                   String            @map("seller_id")
  title                      String
  description                String            @db.Text
  images                     String[]
  threeModelKey              String?           @map("three_model_key")
  proposedStartingPrice      Decimal           @map("proposed_starting_price") @db.Decimal(14, 2)
  proposedReservePrice       Decimal?          @map("proposed_reserve_price") @db.Decimal(14, 2)
  proposedBidIncrement       Decimal           @default(100000) @map("proposed_bid_increment") @db.Decimal(14, 2)

  appraisalCertificateNumber String?           @map("appraisal_certificate_number")
  appraisalAgency            String?           @map("appraisal_agency")
  certificateImages          String[]          @map("certificate_images")
  certificateIssueDate       DateTime?         @map("certificate_issue_date")

  status                     AuctionItemStatus @default(PENDING_REVIEW)
  isSellerFlagged            Boolean           @default(false) @map("is_seller_flagged")
  flagReason                 String?           @map("flag_reason")
  rejectionReason            String?           @map("rejection_reason") @db.Text
  lotNumber                  Int?              @map("lot_number")
  startingPrice              Decimal?          @map("starting_price") @db.Decimal(14, 2)
  reservePrice               Decimal?          @map("reserve_price") @db.Decimal(14, 2)
  bidIncrement               Decimal?          @map("bid_increment") @db.Decimal(14, 2)

  reviewedByAdminId          String?           @map("reviewed_by_admin_id")
  reviewedAt                 DateTime?         @map("reviewed_at")

  createdAt                  DateTime          @default(now()) @map("created_at")
  updatedAt                  DateTime          @updatedAt @map("updated_at")

  auction                    Auction           @relation(fields: [auctionId], references: [id], onDelete: Cascade)
  seller                     User              @relation("SellerAuctionItems", fields: [sellerId], references: [id], onDelete: Restrict)
  reviewedByAdmin            User?             @relation("AdminReviewedAuctionItems", fields: [reviewedByAdminId], references: [id], onDelete: SetNull)

  @@index([auctionId, status])
  @@index([sellerId])
  @@map("auction_items")
}

model Bid {
  id        String    @id @default(uuid())
  auctionId String    @map("auction_id")
  bidderId  String    @map("bidder_id")
  bidAmount Decimal   @map("bid_amount") @db.Decimal(14, 2)
  status    BidStatus @default(ACCEPTED)
  placedAt  DateTime  @default(now()) @map("placed_at")

  auction Auction @relation(fields: [auctionId], references: [id], onDelete: Cascade)
  award AuctionAward?
  bidder  User    @relation(fields: [bidderId], references: [id], onDelete: Restrict)

  @@index([auctionId, placedAt])
  @@map("bids")
}

/// A single winning offer and its order, with a durable checkout deadline and deposit ownership.
model AuctionAward {
  id            String   @id @default(uuid())
  auctionId     String   @map("auction_id")
  bidId         String   @unique @map("bid_id")
  orderId       String   @unique @map("order_id")
  depositAmount Decimal  @map("deposit_amount") @db.Decimal(14, 2)
  status        String   @default("AWAITING_CHECKOUT")
  expiresAt     DateTime @map("expires_at")
  completedAt   DateTime? @map("completed_at")
  auction       Auction  @relation(fields: [auctionId], references: [id], onDelete: Restrict)
  bid           Bid      @relation(fields: [bidId], references: [id], onDelete: Restrict)
  order         Order    @relation(fields: [orderId], references: [id], onDelete: Restrict)

  @@index([status, expiresAt])
  @@map("auction_awards")
}

model EscrowRecord {
  id           String       @id @default(uuid())
  orderId      String       @unique @map("order_id")
  totalAmount  Decimal      @map("total_amount") @db.Decimal(14, 2)
  platformFee  Decimal      @map("platform_fee") @db.Decimal(14, 2)
  sellerPayout Decimal      @map("seller_payout") @db.Decimal(14, 2)
  status       EscrowStatus @default(HELD)
  heldAt       DateTime     @default(now()) @map("held_at")
  disbursedAt  DateTime?    @map("disbursed_at")
  refundedAt   DateTime?    @map("refunded_at")

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@map("escrow_records")
}

model Shipment {
  id               String         @id @default(uuid())
  orderId          String         @unique @map("order_id")
  carrier          CarrierName    @default(GHN)
  trackingNumber   String?        @map("tracking_number")
  shippingFee      Decimal        @map("shipping_fee") @db.Decimal(14, 2)
  chargeableWeight Decimal        @map("chargeable_weight") @db.Decimal(10, 2)
  isInternational  Boolean        @default(false) @map("is_international")
  customsFee       Decimal        @default(0) @map("customs_fee") @db.Decimal(14, 2)
  status           ShipmentStatus @default(CREATED)
  waybillCode      String?        @map("waybill_code")
  metadata         Json?
  createdAt        DateTime       @default(now()) @map("created_at")
  updatedAt        DateTime       @updatedAt @map("updated_at")

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@map("shipments")
}

model Dispute {
  id               String        @id @default(uuid())
  orderId          String        @unique @map("order_id")
  openedByUserId   String        @map("opened_by_user_id")
  reason           String        @db.Text
  evidenceUrls     Json?         @map("evidence_urls")
  status           DisputeStatus @default(OPEN)
  resolutionNotes  String?       @map("resolution_notes") @db.Text
  resolvedByUserId String?       @map("resolved_by_user_id")
  resolvedAt       DateTime?     @map("resolved_at")
  createdAt        DateTime      @default(now()) @map("created_at")
  updatedAt        DateTime      @updatedAt @map("updated_at")

  order      Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
  openedBy   User  @relation("DisputeOpener", fields: [openedByUserId], references: [id], onDelete: Restrict)
  resolvedBy User? @relation("DisputeResolver", fields: [resolvedByUserId], references: [id], onDelete: Restrict)

  @@map("disputes")
}

model Review {
  id           String   @id @default(uuid())
  orderId      String   @unique @map("order_id")
  reviewerId   String   @map("reviewer_id")
  targetUserId String   @map("target_user_id")
  rating       Decimal  @db.Decimal(2, 1)
  comment      String?  @db.Text
  isShopReview Boolean  @default(true) @map("is_shop_review")
  createdAt    DateTime @default(now()) @map("created_at")

  order      Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
  reviewer   User  @relation("Reviewer", fields: [reviewerId], references: [id], onDelete: Restrict)
  targetUser User  @relation("Reviewee", fields: [targetUserId], references: [id], onDelete: Restrict)

  @@map("reviews")
}

model ProductReview {
  id         String   @id @default(uuid())
  orderId    String   @map("order_id")
  productId  String   @map("product_id")
  reviewerId String   @map("reviewer_id")
  rating     Int
  comment    String?  @db.Text
  createdAt  DateTime @default(now()) @map("created_at")
  order      Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product    Product  @relation(fields: [productId], references: [id], onDelete: Restrict)
  reviewer   User     @relation(fields: [reviewerId], references: [id], onDelete: Restrict)

  @@unique([orderId, productId])
  @@index([productId, createdAt])
  @@map("product_reviews")
}

model CustomerReview {
  id        String   @id @default(uuid())
  orderId   String   @unique @map("order_id")
  sellerId  String   @map("seller_id")
  buyerId   String   @map("buyer_id")
  rating    Int
  comment   String?  @db.Text
  createdAt DateTime @default(now()) @map("created_at")
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  seller    User     @relation("CustomerReviewer", fields: [sellerId], references: [id], onDelete: Restrict)
  buyer     User     @relation("CustomerReviewee", fields: [buyerId], references: [id], onDelete: Restrict)

  @@index([buyerId, createdAt])
  @@map("customer_reviews")
}

/// Creator ordering is immutable after a banner is created.
enum BannerCreatorRole {
  ADMIN
  STAFF
}

model EventBanner {
  id        String    @id @default(uuid())
  title     String
  imageUrl  String    @map("image_url")
  targetUrl String?   @map("target_url")
  startsAt  DateTime? @map("starts_at")
  endsAt    DateTime? @map("ends_at")
  isActive  Boolean   @default(true) @map("is_active")
  priority  Int       @default(0)
  creatorId String    @map("creator_id")
  creatorRole BannerCreatorRole @map("creator_role")
  auctionId String? @map("auction_id")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  creator   User      @relation(fields: [creatorId], references: [id], onDelete: Restrict)
  auction Auction? @relation(fields: [auctionId], references: [id], onDelete: SetNull)
  disableHistory BannerDisableHistory[]

  @@index([isActive, startsAt, endsAt])
  @@index([creatorRole, createdAt, id])
  @@map("event_banners")
}

/// Append-only attribution of a completed banner deactivation, including historical identity snapshots.
model BannerDisableHistory {
  id String @id @default(uuid())
  bannerId String @map("banner_id")
  bannerTitle String @map("banner_title")
  creatorId String @map("creator_id")
  creatorName String @map("creator_name")
  creatorRole BannerCreatorRole @map("creator_role")
  actorId String @map("actor_id")
  actorName String @map("actor_name")
  actorRole Role @map("actor_role")
  source String
  wasActive Boolean @default(true) @map("was_active")
  isActive Boolean @default(false) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  banner EventBanner @relation(fields: [bannerId], references: [id], onDelete: Restrict)
  actor User @relation(fields: [actorId], references: [id], onDelete: Restrict)

  @@index([bannerId, createdAt])
  @@index([actorId, createdAt])
  @@index([createdAt, id])
  @@map("banner_disable_history")
}

model EventLog {
  id         String   @id @default(uuid())
  eventName  String   @map("event_name")
  payload    Json
  operatorId String?  @map("operator_id")
  traceId    String?  @map("trace_id")
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([eventName, createdAt])
  @@map("event_logs")
}

model Notification {
  /// Optional destination for auction notifications; legacy notifications remain readable.
  auctionId String? @map("auction_id")
  targetUrl String? @map("target_url")
  id        String              @id @default(uuid())
  userId    String              @map("user_id")
  title     String
  content   String              @db.Text
  type      NotificationType    @default(SYSTEM)
  channel   NotificationChannel @default(IN_APP)
  isRead    Boolean             @default(false) @map("is_read")
  readAt    DateTime?           @map("read_at")
  createdAt DateTime            @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("notifications")
}

model NotificationPreference {
  id        String              @id @default(uuid())
  userId    String              @map("user_id")
  channel   NotificationChannel
  isEnabled Boolean             @default(true) @map("is_enabled")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, channel])
  @@map("notification_preferences")
}

model SellerUpgradeRequest {
  id                 String              @id @default(uuid())
  userId             String              @map("user_id")
  storeName          String              @map("store_name")
  storeDescription   String?             @map("store_description") @db.Text
  phone              String
  businessEmail      String?             @map("business_email")
  identityCardNumber String?             @map("identity_card_number")
  attachmentUrl      String?             @map("attachment_url")
  street             String?             @map("street")
  ward               String?             @map("ward")
  district           String?             @map("district")
  city               String?             @map("city")
  latitude           Decimal?            @db.Decimal(10, 8)
  longitude          Decimal?            @db.Decimal(11, 8)
  formattedAddress   String?             @map("formatted_address")
  placeId            String?             @map("place_id")
  status             SellerRequestStatus @default(PENDING)
  rejectionReason    String?             @map("rejection_reason") @db.Text
  reviewedByAdminId  String?             @map("reviewed_by_admin_id")
  reviewedAt         DateTime?           @map("reviewed_at")
  createdAt          DateTime            @default(now()) @map("created_at")
  updatedAt          DateTime            @updatedAt @map("updated_at")

  user       User  @relation("UserSellerRequests", fields: [userId], references: [id], onDelete: Cascade)
  reviewedBy User? @relation("AdminReviewedSellerRequests", fields: [reviewedByAdminId], references: [id], onDelete: SetNull)

  @@index([userId, status])
  @@index([status, createdAt])
  @@map("seller_upgrade_requests")
}

model StaffInvitation {
  id            String   @id @default(uuid())
  fullName      String   @map("full_name") @db.VarChar(255)
  personalEmail String   @map("personal_email") @db.VarChar(255)
  phoneNumber   String?  @map("phone_number") @db.VarChar(50)
  department    String?  @map("department") @db.VarChar(100)
  token         String   @unique @db.VarChar(255)
  otp           String?  @map("otp") @db.VarChar(10)
  expiresAt     DateTime @map("expires_at") @db.Timestamp(6)
  isAccepted    Boolean  @default(false) @map("is_accepted")
  assignedEmail String?  @map("assigned_email") @db.VarChar(255)
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamp(6)

  @@map("staff_invitations")
}

model ShopActionLog {
  id        String         @id @default(uuid())
  shopId    String         @map("shop_id")
  adminId   String         @map("admin_id")
  action    ShopActionType
  reason    String         @db.Text
  createdAt DateTime       @default(now()) @map("created_at")

  shop  User @relation("ShopActionLogs", fields: [shopId], references: [id], onDelete: Cascade)
  admin User @relation("AdminShopActionLogs", fields: [adminId], references: [id], onDelete: Restrict)

  @@index([shopId, createdAt])
  @@map("shop_action_logs")
}

model ShopViolation {
  id               String          @id @default(uuid())
  shopId           String          @map("shop_id")
  productId        String?         @map("product_id")
  reporterId       String?         @map("reporter_id")
  title            String
  description      String          @db.Text
  evidenceUrls     Json?           @map("evidence_urls")
  penaltyLevel     String?         @map("penalty_level")
  status           ViolationStatus @default(PENDING)
  resolutionNotes  String?         @map("resolution_notes") @db.Text
  handledByAdminId String?         @map("handled_by_admin_id")
  handledAt        DateTime?       @map("handled_at")
  createdAt        DateTime        @default(now()) @map("created_at")
  updatedAt        DateTime        @updatedAt @map("updated_at")

  shop      User     @relation("ShopViolations", fields: [shopId], references: [id], onDelete: Cascade)
  product   Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
  reporter  User?    @relation("ReportedShopViolations", fields: [reporterId], references: [id], onDelete: SetNull)
  handledBy User?    @relation("HandledShopViolations", fields: [handledByAdminId], references: [id], onDelete: SetNull)

  @@index([shopId, status])
  @@map("shop_violations")
}

model WithdrawalRequest {
  id                String           @id @default(uuid())
  userId            String           @map("user_id")
  amount            Decimal          @db.Decimal(14, 2)
  bankName          String           @map("bank_name")
  accountNumber     String           @map("account_number")
  accountHolderName String           @map("account_holder_name")
  status            WithdrawalStatus @default(PENDING)
  rejectionReason   String?          @map("rejection_reason") @db.Text
  adminNote         String?          @map("admin_note") @db.Text
  reviewedByAdminId String?          @map("reviewed_by_admin_id")
  reviewedAt        DateTime?        @map("reviewed_at")
  createdAt         DateTime         @default(now()) @map("created_at")
  updatedAt         DateTime         @updatedAt @map("updated_at")

  user       User  @relation("UserWithdrawalRequests", fields: [userId], references: [id], onDelete: Cascade)
  reviewedBy User? @relation("AdminReviewedWithdrawals", fields: [reviewedByAdminId], references: [id], onDelete: SetNull)

  @@index([userId, status])
  @@map("withdrawal_requests")
}

model ChatConversation {
  id               String    @id @default(uuid())
  type             String    @default("BUYER_SELLER")
  participant1Id   String    @map("participant1_id")
  participant2Id   String?   @map("participant2_id")
  assignedStaffId  String?   @map("assigned_staff_id")
  title            String?   @db.Text
  contextId        String?   @map("context_id")
  contextType      String?   @map("context_type")
  lastMessage      String?   @map("last_message") @db.Text
  lastMessageAt    DateTime? @map("last_message_at")
  unreadCountUser1 Int       @default(0) @map("unread_count_user1")
  unreadCountUser2 Int       @default(0) @map("unread_count_user2")
  status           String    @default("OPEN")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  participant1  User          @relation("ChatParticipant1", fields: [participant1Id], references: [id], onDelete: Cascade)
  participant2  User?         @relation("ChatParticipant2", fields: [participant2Id], references: [id], onDelete: Cascade)
  assignedStaff User?         @relation("AssignedStaffConversations", fields: [assignedStaffId], references: [id], onDelete: SetNull)
  messages      ChatMessage[]

  @@index([participant1Id, participant2Id])
  @@index([assignedStaffId])
  @@index([contextId])
  @@index([contextId, contextType])
  @@index([status])
  @@map("chat_conversations")
}

model ChatMessage {
  id             String    @id @default(uuid())
  conversationId String    @map("conversation_id")
  senderId       String    @map("sender_id")
  body           String    @db.Text
  attachments    Json?     @default("[]")
  isRead         Boolean   @default(false) @map("is_read")
  readAt         DateTime? @map("read_at")
  createdAt      DateTime  @default(now()) @map("created_at")

  conversation ChatConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender       User             @relation("ChatSender", fields: [senderId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
  @@index([senderId])
  @@map("chat_messages")
}

model ChatAutoReply {
  id           String    @id @default(uuid())
  scope        String    @default("SHOP")
  shopId       String?   @map("shop_id")
  name         String?   @db.Text
  triggerType  String    @default("WELCOME") @map("trigger_type")
  keyword      String?   @db.Text
  content      String    @db.Text
  isActive     Boolean   @default(true) @map("is_active")
  status       String    @default("ACTIVE")
  cancelReason String?   @map("cancel_reason") @db.Text
  cancelledBy  String?   @map("cancelled_by")
  cancelledAt  DateTime? @map("cancelled_at")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  shop            User? @relation("ShopAutoReplies", fields: [shopId], references: [id], onDelete: Cascade)
  cancelledByUser User? @relation("AdminCancelledReplies", fields: [cancelledBy], references: [id], onDelete: SetNull)

  @@index([shopId, scope])
  @@index([status])
  @@map("chat_auto_replies")
}
