{
  "name": "nexus-backend",
  "version": "1.0.0",
  "private": true,
  "description": "Project Nexus - Modular Monolith Backend",
  "scripts": {
    "build": "prisma generate && nest build && npm run build:release",
    "build:release": "tsc -p tsconfig.release.json",
    "format": "prettier --write \"src/**/*.ts\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy",
    "prisma:seed": "ts-node prisma/seeds/system.ts",
    "prisma:studio": "prisma studio",
    "lint": "eslint .",
    "docs:openapi": "ts-node src/scripts/export-openapi.ts",
    "test": "vitest run",
    "test:unit": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit && npm run typecheck:test && npm run typecheck:seeds",
    "typecheck:test": "tsc --noEmit -p tsconfig.test.json",
    "db:verify": "node prisma/scripts/verify-constraints.mjs",
    "db:bootstrap": "ts-node prisma/seeds/system.ts",
    "admin:create": "ts-node prisma/seeds/admin-create.ts",
    "seed:demo": "ts-node prisma/seeds/demo/index.ts",
    "seed:demo:reset": "ts-node prisma/seeds/demo/index.ts --reset",
    "typecheck:seeds": "tsc --noEmit -p tsconfig.seeds.json",
    "check:cycles": "node scripts/check-import-cycles.mjs",
    "env:check": "node scripts/check-env.mjs"
  },
  "dependencies": {
    "@nestjs/common": "^12.6.3",
    "@nestjs/config": "^12.1.1",
    "@nestjs/core": "^12.6.3",
    "@nestjs/event-emitter": "^12.0.3",
    "@nestjs/jwt": "^12.0.5",
    "@nestjs/passport": "^12.0.2",
    "@nestjs/platform-express": "^12.6.3",
    "@nestjs/platform-socket.io": "^12.6.3",
    "@nestjs/swagger": "^12.1.3",
    "@nestjs/throttler": "^6.8.0",
    "@nestjs/websockets": "^12.6.3",
    "@nexus/contracts": "*",
    "@payos/node": "^2.0.6",
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "bcrypt": "^6.0.0",
    "dotenv": "^18.0.10",
    "file-type": "^16.5.4",
    "helmet": "^8.3.0",
    "ioredis": "^6.1.0",
    "nestjs-pino": "^5.3.2",
    "nodemailer": "^10.6.1",
    "passport": "^0.7.0",
    "passport-google-oauth20": "^2.0.0",
    "passport-jwt": "^4.0.1",
    "pg": "^8.23.1",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0",
    "prisma": "^7.10.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "socket.io": "^4.8.4"
  },
  "devDependencies": {
    "@nestjs/cli": "^12.0.15",
    "@nestjs/schematics": "^12.0.6",
    "@nestjs/testing": "^12.6.3",
    "@nexus/config": "*",
    "@swc/core": "^1.16.22",
    "@types/bcrypt": "^6.0.0",
    "@types/express": "^5.0.6",
    "@types/multer": "^2.3.0",
    "@types/node": "^26.6.11",
    "@types/nodemailer": "^8.0.2",
    "@types/passport-google-oauth20": "^2.0.17",
    "@types/passport-jwt": "^4.0.2",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.2.1",
    "@vitest/coverage-v8": "^5.1.2",
    "supertest": "^7.3.2",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3",
    "unplugin-swc": "^2.0.0",
    "vitest": "^5.1.2"
  },
  "prisma": {
    "seed": "ts-node prisma/seeds/system.ts"
  }
}
