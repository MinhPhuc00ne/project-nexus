# ==============================================================================
# 1. Runtime & App Mode
# ==============================================================================
NODE_ENV=development
APP_ENV=development          # development | demo | production
PORT=3000
PORT_BACKEND=3000
SWAGGER_ENABLED=true

# ==============================================================================
# 2. Database & Redis
# ==============================================================================
POSTGRES_USER=postgres
POSTGRES_PASSWORD=nexus_secret_2026
POSTGRES_DB=nexus_main
POSTGRES_PORT=5432
DATABASE_URL="postgresql://postgres:nexus_secret_2026@localhost:5432/nexus_main?schema=public"
# Used by prisma migrate dev to diff a schema change in isolation.
SHADOW_DATABASE_URL="postgresql://postgres:nexus_secret_2026@localhost:5432/nexus_shadow?schema=public"

REDIS_URL="redis://localhost:6379"
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ==============================================================================
# 3. Security & URLs
# ==============================================================================
JWT_SECRET=super-secret-jwt-key-nexus-change-in-production-2026
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_SECRET=super-secret-refresh-key-nexus-change-in-production-2026
REFRESH_TOKEN_EXPIRES_IN=30d

FRONTEND_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173
APP_PUBLIC_URL=http://localhost:3000

# ==============================================================================
# 4. Provider Selection (Clone-and-Run Defaults)
# ==============================================================================
# Every external dependency is chosen explicitly. Production refuses to boot on
# stub providers, while local and demo runs use sandbox/local stubs by default.
PAYMENT_PROVIDER=sandbox      # payos | sandbox
SHIPPING_PROVIDER=sandbox     # ghn | sandbox
STORAGE_PROVIDER=local        # cloudinary | local
MAIL_PROVIDER=console         # smtp | console
CHATBOT_AI_ENABLED=false      # true | false

# ==============================================================================
# 5. Optional External Credentials (leave blank until enabled)
# ==============================================================================
PAYOS_CLIENT_ID=
PAYOS_API_KEY=
PAYOS_CHECKSUM_KEY=

GHN_API_URL=
GHN_TOKEN=
GHN_SHOP_ID=
GHN_CLIENT_ID=
GHN_WEBHOOK_SECRET=

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=

GEMINI_API_KEY=
CHATBOT_GEMINI_MODEL=
