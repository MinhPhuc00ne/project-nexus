NODE_ENV=development

POSTGRES_USER=postgres
POSTGRES_PASSWORD=nexus_secret_2026
POSTGRES_DB=nexus_main
POSTGRES_PORT=5432
DATABASE_URL="postgresql://postgres:nexus_secret_2026@localhost:5432/nexus_main?schema=public"
# Used by prisma migrate dev to diff a schema change in isolation.
SHADOW_DATABASE_URL="postgresql://postgres:nexus_secret_2026@localhost:5432/nexus_shadow?schema=public"

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_URL="redis://localhost:6379"

JWT_SECRET=super-secret-jwt-key-nexus-change-in-production-2026
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_SECRET=super-secret-refresh-key-nexus-change-in-production-2026
REFRESH_TOKEN_EXPIRES_IN=30d

PORT_BACKEND=3000
FRONTEND_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173
APP_PUBLIC_URL=http://localhost:3000

# Which external provider each concern uses. Nothing is inferred from whether a
# key happens to be set: a missing key used to make the service quietly swap in a
# stub, so a deployment could look healthy while sending no email and charging no
# card. Production refuses to boot on a stub, and a real provider must carry its
# credentials. Local and demo runs select the stubs on purpose, which is what lets
# somebody run the whole flow without a PayOS or GHN account.
PAYMENT_PROVIDER=sandbox      # payos | sandbox
SHIPPING_PROVIDER=sandbox     # ghn | sandbox
STORAGE_PROVIDER=local        # cloudinary | local
MAIL_PROVIDER=console         # smtp | console

CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

PAYOS_CLIENT_ID=your-payos-client-id
PAYOS_API_KEY=your-payos-api-key
PAYOS_CHECKSUM_KEY=your-payos-checksum-key

GHN_API_URL=https://dev-online-gateway.ghn.vn/shiip/public-api/v2
GHN_TOKEN=your-ghn-sandbox-token
GHN_SHOP_ID=123456
GHN_CLIENT_ID=123456
GHN_WEBHOOK_SECRET=nexus_ghn_webhook_secret_2026

PLATFORM_FEE_PERCENTAGE=7.0
AUCTION_ANTI_SNIPING_TRIGGER_MINUTES=2
AUCTION_ANTI_SNIPING_EXTEND_MINUTES=5

GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_CALLBACK_URL=http://localhost:3000/api/v1/auth/google/callback

SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=system-mailer@gmail.com
SMTP_PASS=app-specific-password
SMTP_FROM="Nexus System <system-mailer@gmail.com>"

CHATBOT_AI_ENABLED=true
GEMINI_API_KEY=your-gemini-api-key
CHATBOT_GEMINI_MODEL=gemini-3.1-flash-lite

VITE_API_URL=http://localhost:3000/api/v1
